# =============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU — WEBSITE BÁN MÁY TÍNH CŨ TL GAMING
# Hướng dẫn: Sao chép file này thành `.env` tại thư mục gốc dự án và cập nhật
# thông số phù hợp với máy chủ XAMPP / MySQL của bạn.
# =============================================================================

APP_NAME="TL Gaming - Hệ Thống Máy Tính & Linh Kiện Cũ Kiểm Định"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cấu hình kết nối Cơ sở dữ liệu MySQL 8.0 / MariaDB (PDO)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tl_gaming
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cấu hình bảo mật Session Cookie
SESSION_NAME=tlgaming_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Cấu hình thông tin liên hệ cửa hàng (dùng chung Header, Footer, Bottom Nav & Floating Contact Widget)
# Để trống TL_ZALO_URL / TL_FACEBOOK_URL / TL_MESSENGER_URL nếu chưa có tài khoản chính thức;
# khi TL_SHOW_UNCONFIGURED_CHANNELS=true, icon vẫn hiển thị đẹp và báo "Kênh liên hệ đang được cập nhật." khi bấm.
TL_HOTLINE_DISPLAY="1900 8868"
TL_HOTLINE_TEL="19008868"
TL_HOTLINE_HOURS="08:30 – 21:00"
TL_SUPPORT_EMAIL="hotro@tlgaming.vn"
TL_ZALO_URL=""
TL_ZALO_PHONE=""
TL_FACEBOOK_URL=""
TL_MESSENGER_URL=""
TL_SHOW_UNCONFIGURED_CHANNELS=true
